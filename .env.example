# AMPLIQ — environment configuration
#
# Copy to .env.local and fill in. Every value is optional: with none of them set
# the site builds and runs, sets no tracking cookies, links to no social profiles
# that do not exist, and shows the contact form in preview mode.

# --- Site ---------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://ampliq.de"

# Public contact address shown in the footer and on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL="hello@ampliq.de"
# NEXT_PUBLIC_CONTACT_PHONE="+49 ..."

# --- Social -------------------------------------------------------------
# Links render only when set — an unset profile is omitted rather than linked
# to a page that does not exist.
# NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/..."
# NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/..."

# --- Contact form -------------------------------------------------------
# Endpoint that accepts a JSON POST (Resend via a route handler, Formspree,
# HubSpot, …). While unset the form validates and shows a preview state that
# explicitly says nothing was transmitted.
# NEXT_PUBLIC_CONTACT_ENDPOINT="https://formspree.io/f/xxxxxxxx"

# --- Legal (Impressum) --------------------------------------------------
# Required before launch. Unset fields render as a visible "to be supplied"
# marker rather than an invented value.
# NEXT_PUBLIC_LEGAL_COMPANY="AMPLIQ ..."
# NEXT_PUBLIC_LEGAL_FORM="Einzelunternehmen"
# NEXT_PUBLIC_LEGAL_REPRESENTATIVE="..."
# NEXT_PUBLIC_LEGAL_STREET="..."
# NEXT_PUBLIC_LEGAL_POSTAL_CODE="..."
# NEXT_PUBLIC_LEGAL_CITY="..."
# NEXT_PUBLIC_LEGAL_COUNTRY="Deutschland"
# NEXT_PUBLIC_LEGAL_EMAIL="..."
# NEXT_PUBLIC_LEGAL_PHONE="..."
# NEXT_PUBLIC_LEGAL_VAT_ID="DE..."
# NEXT_PUBLIC_LEGAL_REGISTER_COURT="..."
# NEXT_PUBLIC_LEGAL_REGISTER_NUMBER="..."
# NEXT_PUBLIC_LEGAL_DPO="..."

# --- Analytics ----------------------------------------------------------
# Nothing loads unless an ID is set. Add a consent mechanism before enabling
# any of these — under GDPR/TTDSG they must not run before consent.
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_META_PIXEL_ID="..."
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID="..."
