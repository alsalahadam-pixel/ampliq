# AMPLIQ — environment configuration
#
# Copy to .env.local and fill in.
#
# The site builds and runs with none of these set: it sets no tracking cookies,
# links to no social profiles that do not exist, states on the page that no
# calendar is connected, and reports plainly that the contact form could not
# deliver. Nothing is faked to cover a missing value.
#
# The legal entity block is the exception — those values are required before
# launch, and the legal pages say so on the page until they are supplied.

# --- Site ---------------------------------------------------------------
# THE DOMAIN IS SET IN ONE PLACE. Everything else derives from it: the
# canonical URL, hreflang, the sitemap, Open Graph, and all three published
# email addresses. Once the final domain is bought, change this line and the
# whole site follows.
NEXT_PUBLIC_SITE_DOMAIN="ampliq.net"

# Only if the origin differs from https://<domain> — a staging host, or a
# deployment behind a different hostname. Normally leave this unset.
# NEXT_PUBLIC_SITE_URL="https://ampliq.net"

# The three published addresses. Each defaults to <name>@<domain> above, so
# they only need setting if a mailbox lives somewhere else.
#
#   project@  everything to do with a project: the Start-a-project flow, the
#             enquiry form, the booking, and every automated message either of
#             them sends — the notification to you, the acknowledgement to the
#             client, the booking confirmation. It is also the sender address
#             and the reply-to in those mails.
#   info@     the general company address: the footer, the Impressum, the
#             organisation record. Anything that is not about a project.
#   help@     support for existing clients.
#
# NEXT_PUBLIC_CONTACT_PROJECT_EMAIL="project@ampliq.net"
# NEXT_PUBLIC_CONTACT_INFO_EMAIL="info@ampliq.net"
# NEXT_PUBLIC_CONTACT_HELP_EMAIL="help@ampliq.net"

# No phone number is published unless one is set here. Nothing is invented.
# NEXT_PUBLIC_CONTACT_PHONE="+49 ..."

# --- Social -------------------------------------------------------------
# Links render only when set — an unset profile is omitted rather than linked
# to a page that does not exist.
# NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/..."
# NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/..."

# --- Email delivery -----------------------------------------------------
# One transport serves both the enquiry form and the booking confirmations.
# Until one is set, the form reports honestly that nothing was sent (HTTP 503)
# and the booking confirmation screen says no email went out.
#
# Option A — Resend. Create an API key and verify the sending domain first.
# RESEND_API_KEY="re_..."
#
# Option B — any endpoint that accepts { to, subject, html, text } as JSON.
# MAIL_ENDPOINT="https://..."
# MAIL_ENDPOINT_TOKEN="..."          # sent as a bearer token when set
#
# MAIL_FROM_EMAIL="project@ampliq.net"   # defaults to project@; must be verified
# MAIL_FROM_NAME="AMPLIQ"
# MAIL_NOTIFICATION_EMAIL="project@ampliq.net"  # where enquiries and bookings land
# MAIL_REPLY_TO="project@ampliq.net"

# --- Legal entity -------------------------------------------------------
# REQUIRED BEFORE LAUNCH. Every unset field renders on the legal pages as a
# highlighted [PLACEHOLDER] and is listed in the "required before launch" band
# at the top of each document. Nothing here is ever invented — an unset value
# is shown as missing, not filled in with something plausible.
#
# AMPLIQ is not currently a registered company. Do not enter a GmbH, UG,
# Handelsregister number or VAT ID that does not exist.
# NEXT_PUBLIC_LEGAL_COMPANY="..."             # [LEGAL NAME]
# NEXT_PUBLIC_LEGAL_FORM="Einzelunternehmen"  # [LEGAL FORM]
# NEXT_PUBLIC_LEGAL_REPRESENTATIVE="..."      # [RESPONSIBLE PERSON]
# NEXT_PUBLIC_LEGAL_STREET="..."              # [BUSINESS ADDRESS]
# NEXT_PUBLIC_LEGAL_POSTAL_CODE="..."         # [POSTAL CODE]
# NEXT_PUBLIC_LEGAL_CITY="..."                # [CITY]
# NEXT_PUBLIC_LEGAL_COUNTRY="Deutschland"
# NEXT_PUBLIC_LEGAL_EMAIL="..."
#
# Only where they genuinely apply to the legal form:
# NEXT_PUBLIC_LEGAL_PHONE="..."               # [PHONE IF APPLICABLE]
# NEXT_PUBLIC_LEGAL_VAT_ID="DE..."            # [VAT ID IF APPLICABLE]
# NEXT_PUBLIC_LEGAL_TAX_NUMBER="..."          # [TAX NUMBER IF APPLICABLE]
# NEXT_PUBLIC_LEGAL_REGISTER_COURT="..."      # [REGISTRATION INFORMATION ...]
# NEXT_PUBLIC_LEGAL_REGISTER_NUMBER="..."     # [REGISTRATION NUMBER ...]
# NEXT_PUBLIC_LEGAL_AUTHORITY="..."           # [SUPERVISORY AUTHORITY ...]
# NEXT_PUBLIC_LEGAL_DPO="..."                 # [DATA PROTECTION CONTACT]

# --- Booking (/start) ---------------------------------------------------
# All optional. With none of them set the booking flow still works: it shows
# the published working hours, says clearly that no calendar was consulted,
# records bookings in memory, and states that no confirmation email was sent.
# Full setup guide: docs/booking.md

# Schedule. Defaults shown; the working-hours default is Mon-Thu 09:30-12:30
# and 13:30-17:30, Fri 09:30-13:00.
# BOOKING_TIMEZONE="Europe/Berlin"
# BOOKING_SLOT_MINUTES="30"
# BOOKING_BUFFER_MINUTES="15"
# BOOKING_MINIMUM_NOTICE_HOURS="24"
# BOOKING_HORIZON_DAYS="60"
# BOOKING_STEP_MINUTES="30"
# BOOKING_WORKING_HOURS="mon-thu 09:30-12:30,13:30-17:30; fri 09:30-13:00"
# BOOKING_BLACKOUT_DATES="2026-12-24,2026-12-25"

# Calendar. Pick one, or leave unset — availability is then labelled
# "provisional" rather than presented as a live calendar check.
# Only busy times are ever read; no event details are requested or stored.
# BOOKING_CALENDAR_PROVIDER="google"   # google | microsoft | none

# Google Calendar, via a service account (see docs/booking.md).
# GOOGLE_CALENDAR_ID="you@example.com"
# GOOGLE_CALENDAR_CLIENT_EMAIL="...@....iam.gserviceaccount.com"
# GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_IMPERSONATE="you@example.com"
# GOOGLE_CALENDAR_SEND_INVITES="false"

# Microsoft 365 / Outlook, via Graph client credentials.
# MICROSOFT_TENANT_ID="..."
# MICROSOFT_CLIENT_ID="..."
# MICROSOFT_CLIENT_SECRET="..."
# MICROSOFT_CALENDAR_USER="you@yourdomain.com"

# How the call happens. Set a standing meeting link and it appears in the
# confirmation email; leave it unset and the email says the details follow by
# reply, rather than inventing a link.
# BOOKING_MEETING_LINK="https://meet.google.com/..."
#
# Email for bookings uses the shared transport configured above.

# --- Analytics ----------------------------------------------------------
# Nothing loads unless an ID is set. Add a consent mechanism before enabling
# any of these — under GDPR/TTDSG they must not run before consent.
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
# NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_META_PIXEL_ID="..."
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID="..."
